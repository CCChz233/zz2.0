# ===== MCP配置（可选功能，默认关闭） =====

# 是否启用MCP搜索（默认false，保持原有行为）
USE_MCP_SEARCH=false

# 是否启用MCP管理器（默认false）
USE_MCP_MANAGER=false

# 如果启用MCP，以下是配置示例
# MCP预设配置（JSON格式）
# MCP_PRESET_CONFIGS='[
#   {
#     "id": "github",
#     "name": "GitHub",
#     "server_type": "github",
#     "command": "npx",
#     "args": ["-y", "@modelcontextprotocol/server-github"],
#     "env": {},
#     "enabled": true
#   }
# ]'

# GitHub配置（如果要使用GitHub MCP）
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxx

# Slack配置（如果要使用Slack MCP）
# SLACK_TOKEN=xoxb-xxxxx

# Brave搜索配置（如果要使用Brave MCP）
# BRAVE_API_KEY=xxxxx
